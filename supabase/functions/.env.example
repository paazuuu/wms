# Delivery-note OCR (ocr-delivery-note) — LOCAL DEV ONLY.
#
# For the DEPLOYED function on Supabase, do NOT use this file. Set secrets in the
# dashboard (Project Settings -> Edge Functions -> Secrets) or via the CLI:
#   supabase secrets set GEMINI_API_KEY=...
#
# For local runs (`supabase functions serve --env-file supabase/functions/.env`),
# copy this file to `.env` and fill it in. Never commit the real `.env`.
GEMINI_API_KEY=your-google-ai-studio-key
GEMINI_MODEL=gemini-2.0-flash
